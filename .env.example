# ---------------------------------------------------------------------------
# MyFinance — variáveis de ambiente
# Configure essas mesmas chaves em: Vercel → Project → Settings → Environment Variables
# ---------------------------------------------------------------------------

# Postgres gerenciado (Neon ou Supabase, ambos com plano grátis) — use a
# connection string "pooled" (no Neon o host tem "-pooler"; no Supabase,
# aba Database → Connection pooling, modo "Transaction"). Sem pooling,
# poucas requisições simultâneas já esgotam as conexões do banco em
# ambiente serverless.
DATABASE_URL="postgresql://usuario:senha@host-pooler.exemplo.neon.tech/myfinance?sslmode=require"

# JWT — gere com: openssl rand -hex 32
JWT_SECRET=troque-por-uma-string-aleatoria-grande

# Protege as rotas /api/cron/* contra chamadas externas não autorizadas — a
# Vercel manda esse valor automaticamente como "Authorization: Bearer <valor>"
# quando os crons configurados em vercel.json disparam. Gere com: openssl rand -hex 32
CRON_SECRET=troque-por-outra-string-aleatoria

# Opcional — token do seu bot no Telegram (fale com @BotFather pra criar um
# e pegar o token). Sem isso, os lembretes automáticos ficam desativados,
# mas o resto do sistema funciona normalmente.
TELEGRAM_BOT_TOKEN=

# Preenchido automaticamente pela Vercel quando você ativa Storage → Blob
# no projeto (não precisa colar manualmente, só ativar a integração).
# Sem isso, o upload de comprovante nos lançamentos fica desativado.
BLOB_READ_WRITE_TOKEN=
